    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run"
  },
  "dependencies": { "three": "0.170.0" },
  "devDependencies": {
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.1.0",
    "vitest": "3.0.7"
  }
}
